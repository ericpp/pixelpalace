# Required. Upstream host for Socket.IO and the /api/sk server proxy.
# PUBLIC_EVENT_HOST=https://curiohoster.com

# Required. Event GUID for getblocks, sockets, and LNURL fallback.
# PUBLIC_EVENT_GUID=303fe7e4-32c1-4f67-977d-967f251cb6b0

# Optional. Alby OAuth app client ID. When unset, the Alby payment option is hidden.
# PUBLIC_ALBY_CLIENT_ID=32dVOIuGiA

# Optional. Override OAuth redirect URI if it must differ from the current page URL.
# PUBLIC_ALBY_REDIRECT_URI=https://thepixelpalace.vercel.app

# Server-only Alby OAuth credentials (set in Vercel/Docker runtime, not PUBLIC_).
# ALBY_CLIENT_ID=          # same value as PUBLIC_ALBY_CLIENT_ID
# ALBY_CLIENT_SECRET=
# ALBY_JWT=                  # openssl rand -hex 32

# Full LNURL callback URL. Use {eventGuid} to substitute PUBLIC_EVENT_GUID.
# PUBLIC_LNURL_CALLBACK=https://boostbeach.xyz/lnurlp/tsk-{eventGuid}/callback

# Lightning address (user@domain). Used when PUBLIC_LNURL_CALLBACK is not set,
# and as the default QR payload when no invoice is passed.
# PUBLIC_LIGHTNING_ADDRESS=tsk-58eb81f8-caeb-4c77-a326-36e406207fe0@boostbeach.xyz

# Optional. When a connected wallet cannot keysend, store each split's metadata in
# BoostBox and pay that split's lightning address with the returned description.
# Falls back to one static payment (PUBLIC_LNURL_CALLBACK or PUBLIC_LIGHTNING_ADDRESS)
# when BOOSTBOX_API_KEY is unset. Server-only: the key is never sent to the browser.
# BOOSTBOX_API_KEY=
# BOOSTBOX_URL=https://boostbox.cloud

# Optional. App name shown in the Bitcoin Connect wallet modal.
# PUBLIC_APP_NAME=Boost Beach

# Optional. Venmo profile URL. When set, the Venmo payment option is shown.
# PUBLIC_VENMO_URL=https://account.venmo.com/u/gus-linden

# Optional. PayPal donate URL. When set, the PayPal payment option is shown.
# PUBLIC_PAYPAL_URL=https://www.paypal.com/donate/?cmd=_donations&business=behindthesch3m3s%40protonmail.com&item_name=Jorfest+2026&currency_code=USD

# Optional. Nostr event associated with this page (naddr, nevent, note, or hex id).
# When set, a Zap button appears. Boosts are unchanged.
# PUBLIC_NOSTR_EVENT=naddr1...

# Optional. Fallback relays used to fetch the event and attach zap receipts.
# PUBLIC_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band

# Optional. Watch-time effect unlocks. When true, viewers unlock effects by watching.
# Requires DATABASE_URL.
# PUBLIC_LIVE_ENABLED=true

# Optional. On-screen toast when an effect fires. Set to false to hide it.
# PUBLIC_EFFECT_TOAST=true

# Optional. Stand-in video when Split Kit has no live enclosure. Set to false to leave the player empty.
# PUBLIC_PLACEHOLDER_VIDEO=true
# Optional. HLS or file URL for that stand-in. Defaults to a short JW Player sample.
# PUBLIC_PLACEHOLDER_VIDEO_URL=https://content.jwplatform.com/manifests/yp34SRmf.m3u8

# Postgres connection string for viewer and effect-unlock state (Vercel/Neon/etc.).
# Docker Compose overrides this to postgres://boostbeach:boostbeach@db:5432/boostbeach
# DATABASE_URL=postgres://user:pass@host/db

# Required when PUBLIC_LIVE_ENABLED=true. JWT secret for the anonymous viewer session cookie (viewer).
# openssl rand -hex 32
# VIEWER_JWT=

# Optional. Seconds all viewers wait after anyone sends an effect (default 60).
# Set to 0 to disable the cooldown.
# EFFECT_UNLOCK_SECONDS=60

# Optional. Fire-and-forget webhook when an effect is sent.
# EFFECT_WEBHOOK=

# Optional. Top boosters signpost. By default a boost counts when its podcast matches PODCAST_NAME or
# PUBLIC_APP_NAME, its event guid matches PUBLIC_EVENT_GUID, or its episode guid matches EPISODE_GUID.
# Set any PUBLIC_BOARD_* list below to replace that default. Comma-separated.
# Stored boosts come from the boostboard API. Live boosts are kind 30078 events from this pubkey.
# PUBLIC_BOARD_NOSTR_PUBKEY=804eeaaf5afc67cae9aa50a6ae03571ae693fcb277bd40d64b966b12dcba25ce
# Optional. Kind 9735 nostr zap receipts for this naddr are scored too.
# PUBLIC_BOARD_ZAP_EVENT=naddr1...
# Optional. Kind 9735 lightning zap receipts. Subscribe by pubkey, by naddr, or both.
# Pubkeys are hex or npub, comma-separated. Set this to the lnzap user's pubkey,
# or to the upstream nostrPubkey when that is unset.
# These zaps only count when their podcast guid, title, eventGuid, or episode guid matches the board scope.
# PUBLIC_BOARD_LNZAP_PUBKEYS=
# PUBLIC_BOARD_LNZAP_EVENT=naddr1...
# Time window. A unix timestamp or a date string.
# PUBLIC_BOARD_AFTER=2026-01-08 00:00:00 -0500
# PUBLIC_BOARD_BEFORE=
# PUBLIC_BOARD_PODCASTS=As If: Lit At Boost Beach
# PUBLIC_BOARD_EVENT_GUIDS=58eb81f8-caeb-4c77-a326-36e406207fe0,303fe7e4-32c1-4f67-977d-967f251cb6b0
# PUBLIC_BOARD_EPISODE_GUIDS=c6fa7516-3be6-43a2-b5cf-73484baf49dd
# Optional. Defaults to the boost-board relay set.
# PUBLIC_BOARD_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://nostr-pub.wellorder.net,wss://nostr.oxtr.dev

# Optional. Publish effects to Nostr as kind 30078 events.
# The boost board scores payments, not these effect notices.
# Must be an nsec (or 64-char hex). Set the matching pubkey as PUBLIC_BOARD_NOSTR_PUBKEY
# if the board should subscribe to this publisher.
# PUBLISH_NOSTR_NSEC=nsec1...
# PODCAST_NAME=As If: Lit At Boost Beach
# Podcasting 2.0 feed guid. Published as an i/k tag pair: podcast:guid.
# PODCAST_GUID=917393e3-1b1e-5cef-ace4-edaa54e1f810
# Episode guid. Published as an i/k tag pair: podcast:item:guid.
# EPISODE_GUID=c6fa7516-3be6-43a2-b5cf-73484baf49dd
# PUBLISH_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
